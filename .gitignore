
# ==========================================
# WireTitan - Git Ignore Configuration
# ==========================================

# ==========================================
# SECRETS AND PRIVATE KEYS — NEVER COMMIT
# ==========================================
*.key
*.key.pem
*.p12
*.pfx
# Allow public certificates
!*.crt
!*.pem
# If you need to allow a specific .pem certificate, whitelist it explicitly:
# !tls/wiretitan-ca.crt

# Environment variables and secrets
.env
.env.*
!.env.example
*.secret

# ==========================================
# Node.js
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.npm/
package-lock.json

# ==========================================
# Operating System
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# ==========================================
# Editor and IDE
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================================
# Logs
# ==========================================
*.log
logs/
/tmp/dnsmasq.log

# ==========================================
# Temporary and Build Files
# ==========================================
*.tmp
*.bak
*.old
dist/
build/
coverage/

# ==========================================
# Runtime Files
# ==========================================
*.pid
*.pid.lock

# ==========================================
# Cache Directories
# ==========================================
.cache/
.parcel-cache/
nginx/cache/
/opt/homebrew/var/cache/nginx/
